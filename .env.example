DATABASE_URL=postgresql://tipsy:tipsy_local_password@localhost:5432/tipsy
APP_URL=http://localhost:3005
SESSION_SECRET=replace-with-at-least-32-random-characters

# Safaricom Daraja. Use sandbox while developing and production only with live credentials.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=replace-with-a-random-webhook-token
MPESA_ACCOUNT_REFERENCE=TipsyTheory
# Optional delayed-callback reconciliation. These require the Daraja Transaction Status API role.
MPESA_TRANSACTION_STATUS_INITIATOR=
MPESA_TRANSACTION_STATUS_SECURITY_CREDENTIAL=
MPESA_TRANSACTION_STATUS_RESULT_URL=
MPESA_TRANSACTION_STATUS_TIMEOUT_URL=

# Real OTP delivery adapter. Requests fail closed when this provider is not configured.
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
OTP_SENDER_ID=TipsyTheory

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protects maintenance/worker endpoints used by a scheduler.
INTERNAL_JOB_SECRET=replace-with-a-random-internal-job-secret
